      "parameters": {
        "jsCode": "try {\n  const text = $input.first().json.candidates[0].content.parts[0].text;\n\n  // Regex para capturar o bloco ```json ... ```\n  const regex = /```json\\s*([\\s\\S]*?)```/;\n  const match = text.match(regex);\n\n  if (!match || !match[1]) {\n    return [\n      {\n        json: {\n          resultado: null,\n          analise: 'Imagem não foi processada'\n        }\n      }\n    ];\n  }\n\n  // Extrai e faz parse do JSON\n  const jsonStr = match[1];\n  const parsed = JSON.parse(jsonStr);\n\n  // Remove o bloco de JSON do texto original para gerar a análise\n  const analise = text.replace(regex, '').trim();\n\n  return [\n    {\n      json: {\n        resultado: parsed,\n        analise: analise\n      }\n    }\n  ];\n\n} catch (error) {\n  throw new Error('❌ Erro ao fazer parse do JSON extraído: ' + error.message);\n}\n"
      },
