        "jsonBody": "={\n  \"contents\":[\n    {\n      \"parts\":[\n        {\n          \"text\": \"classifique a imagem e preencha o resultado em json dessa forma: { \\\"QtdMulher\\\": 0, \\\"QtdHomem\\\": 0, \\\"Pessoas\\\": [ { \\\"Pessoa1\\\": { \\\"Sexo\\\": \\\"Mulher\\\", \\\"Classificação\\\": \\\"Criança\\\" }, \\\"Pessoa2\\\": { \\\"Sexo\\\": \\\"Homem\\\", \\\"Classificação\\\": \\\"Adulto\\\" }, \\\"Pessoa3\\\": { \\\"Sexo\\\": \\\"Mulher\\\", \\\"Classificação\\\": \\\"Adulto\\\" } } ] }\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\":\"image/jpeg\",\n            \"data\": \"{{ $json.imageBase64.data }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
