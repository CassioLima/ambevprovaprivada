    {
      "parameters": {
        "jsCode": "try {\n  const text = $input.first().json.candidates[0].content.parts[0].text;\n\n  // Regex melhorado para extrair apenas o bloco JSON correto (terminando com risco)\n  const regex = /{[\\s\\S]*?\"parts\":\\s*{[\\s\\S]*?\"risco\":\\s*(true|false)[\\s\\S]*?}\\s*}/m;\n  const match = text.match(regex);\n\n  if (!match) {\n        return [\n        {\n          json: {\n            risco: false,\n            text: 'Imagem não foi processada'\n          }\n        }\n      ];\n  }\n\n  const jsonStr = match[0];\n  const parsed = JSON.parse(jsonStr);\n\n  return [\n    {\n      json: {\n        risco: parsed.parts?.risco ?? null,\n        text: parsed.text ?? ''\n      }\n    }\n  ];\n} catch (error) {\n  throw new Error(`Erro ao extrair risco do texto: ${error.message}`);\n}"
      },
