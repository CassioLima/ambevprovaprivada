      "name": "Analisa Imagem"
    },
    {
      "parameters": {
        "jsCode": "const binaryData = $input.first().binary;\n\nif (!binaryData || !binaryData.imagem || !binaryData.imagem) {\n  throw new Error('Nenhum dado binário encontrado no campo \"imagem\"');\n}\n\nreturn [\n  {\n    json: {\n      imageBase64: binaryData.imagem,\n      imagemBinary: \"data:image/jpeg;base64,\" + binaryData.imagem.data\n    },\n  },\n];"
      },
