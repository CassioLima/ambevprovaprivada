        "jsonBody": "={\n  \"contents\":[\n    {\n      \"parts\":[\n        {\n          \"text\": \"analise essa imagem, se for uma tentariva de assalto retornar em json o text e uma nova chave no nó parts com nome risco com o valor true caso contrário valor false\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\":\"image/jpeg\",\n            \"data\": \"{{ $json.imageBase64.data }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
